<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>CornDownloader</AssemblyName>
    <RootNamespace>CornDownloader</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003: WinForms wants DPI via SetHighDpiMode only; we declare it in the manifest
         too (Corn Systems standard — awareness is set before the process starts). -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon Condition="Exists('Assets\CornDownloader.ico')">Assets\CornDownloader.ico</ApplicationIcon>

    <!-- Single source of truth for the version. Program/AppInfo reads it via
         AssemblyInformationalVersion; app.manifest's assemblyIdentity is cosmetic
         but keep it in sync when bumping. -->
    <Version>1.3.0</Version>
    <Company>Corn Systems</Company>
    <Authors>Corn Systems</Authors>
    <Product>Corn Downloader</Product>
    <Description>Zero-dependency Windows app downloader and installer by Corn Systems</Description>
    <Copyright>© 2026 Corn Systems</Copyright>
    <RepositoryUrl>https://github.com/Corn-Systems/CornDownloader</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Corn-Systems/CornDownloader</PackageProjectUrl>

    <!-- Publish defaults: `dotnet publish -c Release` produces a single self-contained
         win-x64 exe in bin\Release\net10.0-windows\win-x64\publish\. The .iss picks it
         up from there. Override on the command line if you ever want framework-dependent. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
